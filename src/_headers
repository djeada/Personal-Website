# Netlify response headers. Article images have content-hashed names, so they
# never change in place; the other assets keep their names across releases.
/resources/article-images/*
  Cache-Control: public, max-age=31536000, immutable

/resources/brand/*
  Cache-Control: public, max-age=2592000

/resources/project-previews/*
  Cache-Control: public, max-age=2592000

/favicon.ico
  Cache-Control: public, max-age=2592000

/resources/style.css
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

/app.js
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400
